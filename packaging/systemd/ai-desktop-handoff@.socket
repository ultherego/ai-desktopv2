[Unit]
Description=AI Desktop diagnostic handoff for UID %i (offline)

[Socket]
ListenSequentialPacket=/run/ai-desktop-handoff/%i.sock
SocketUser=%i
SocketMode=0600
DirectoryMode=0755
FileDescriptorName=handoff
Accept=no
Backlog=4
RemoveOnStop=yes
TriggerLimitIntervalSec=60
TriggerLimitBurst=6

# Deliberately no [Install]: only an explicit administrative start activates it.
