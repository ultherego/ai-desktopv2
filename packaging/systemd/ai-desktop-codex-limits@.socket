[Unit]
Description=AI Desktop native Codex limit requests for UID %i

[Socket]
ListenSequentialPacket=/run/ai-desktop-codex-limits/%i.sock
SocketUser=%i
SocketMode=0600
DirectoryMode=0755
FileDescriptorName=codex-limits
Accept=no
Backlog=4
RemoveOnStop=yes
TriggerLimitIntervalSec=60
TriggerLimitBurst=24

[Install]
WantedBy=sockets.target
