[Unit]
Description=AI Desktop approved Claude analysis for UID %i

[Socket]
ListenSequentialPacket=/run/ai-desktop-analysis/%i.sock
SocketUser=%i
SocketMode=0600
DirectoryMode=0755
FileDescriptorName=analysis
Accept=no
Backlog=2
RemoveOnStop=yes
TriggerLimitIntervalSec=60
TriggerLimitBurst=4

# No Install section. Starting this socket requires explicit administration.
